{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moviclone Studio",
  "version": "0.1.0",
  "identifier": "com.moviclone.studio",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Moviclone",
    "category": "DeveloperTool",
    "shortDescription": "Design and run SCADA/HMI projects",
    "longDescription": "Moviclone Studio: the studio (screens, tags, alarms), the operator HMI and the runtime (Modbus drivers, simulator, historian, alarms) in one app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/": "web/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
